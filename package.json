{
  "name": "codex-mobile-bridge-desktop",
  "version": "2.0.0-preview.3",
  "description": "Codex App 手机网关桌面启动器",
  "author": "try2love",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "test:desktop": "node --test tests/localization.test.cjs tests/accounts-ui.test.cjs tests/network.test.cjs tests/desktop.test.cjs tests/notifications-ui.test.cjs tests/account-ui.test.cjs tests/account-startup.test.cjs tests/presentation.test.cjs tests/modes-ui.test.cjs tests/watches-ui.test.cjs tests/attachments-activity.test.cjs tests/fast-mode-ui.test.cjs tests/message-actions-ui.test.cjs tests/gateway-language.test.cjs tests/operation-i18n.test.cjs tests/preview-accounts.test.cjs mobile/tests/clipboard.test.cjs mobile/tests/computer-name.test.cjs mobile/tests/session.test.cjs",
    "test:windows-app": "node scripts/smoke-windows.cjs",
    "icons:desktop": "electron scripts/build-icons.cjs",
    "pack:desktop": "electron-builder --dir --publish never",
    "build:mac": "electron-builder --mac dmg zip --publish never",
    "build:windows": "electron-builder --win nsis zip --x64 --publish never",
    "build:linux": "electron-builder --linux AppImage deb --publish never",
    "test:linux-app": "node scripts/smoke-linux.cjs",
    "test:pairing": "electron scripts/smoke-pairing.cjs",
    "test:updater": "node --test tests/updater.test.cjs tests/update-handoff.test.cjs tests/update-controller.test.cjs",
    "test:update-controller": "node scripts/smoke-update-controller.cjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0"
  },
  "build": {
    "appId": "io.github.try2love.codexmobilebridge",
    "productName": "Codex Mobile Bridge",
    "beforePack": "./scripts/verify-build.cjs",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "desktop/**",
      "web/i18n.js",
      "web/account.js",
      "web/accounts.js",
      "web/account.css",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "dist/gateway",
        "to": "gateway"
      },
      {
        "from": "dist/update-version.json",
        "to": "update-version.json"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "desktop/assets/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "artifactName": "Codex-Mobile-Bridge-${version}-macOS-${arch}.${ext}"
    },
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Codex-Mobile-Bridge-${version}-Windows-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "desktop/assets/icon.png",
      "category": "Development",
      "executableName": "codex-mobile-bridge",
      "artifactName": "Codex-Mobile-Bridge-${version}-Linux-${arch}.${ext}",
      "maintainer": "try2love <try2love@users.noreply.github.com>"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2",
        "iproute2"
      ]
    },
    "nsis": {
      "artifactName": "Codex-Mobile-Bridge-${version}-Windows-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}

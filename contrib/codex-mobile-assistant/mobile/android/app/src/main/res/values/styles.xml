<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#1D1D1F</color>
    <color name="canvas">#FAFAF9</color>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="LaunchTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
